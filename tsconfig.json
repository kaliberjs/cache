{
  "include": [
    "./index.js",
    "./src/**/*",
    "./tests/**/*",
  ],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "lib": ["ES2024"],
    "useUnknownInCatchVariables": false,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true
  }
}
