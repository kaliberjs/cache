{
  "typeAcquisition": {
    "enable": true
  },
  "include": [
    "./src/**/*",
    "./tests/**/*",
  ],
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "baseUrl": ".",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  }
}
